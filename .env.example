# ANKIT JEE Environment Configuration Example
# Copy this file to .env and fill in your actual development/production parameters

# Django Configuration
DEBUG=True
SECRET_KEY=your-django-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database Configuration
POSTGRES_DB=ankit_jee
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_db_password@postgres:5432/ankit_jee

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cloudflare R2 Object Storage (Videos, PDFs, Thumbnails, Images)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ankit-jee-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

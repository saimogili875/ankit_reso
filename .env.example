# AdeptEduverse Production & Development Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ==========================================
# 1. Django API & Security Configuration
# ==========================================
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-char-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,ankit-reso.onrender.com,.onrender.com
ENVIRONMENT=production

# Frontend Cross-Origin & Domain Configuration
FRONTEND_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Cross-Site Cookie Policy (Set 'None' for split Vercel/Render hosting)
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# ==========================================
# 2. PostgreSQL Database (Neon / Supabase)
# ==========================================
# NOTE: The app reads DATABASE_URL first; prefer DATABASE_URL over individual POSTGRES_* parameters.
# NOTE: Supabase direct connections (port 5432) are IPv6-only and may fail on Render.
# Always use the Session pooler URI (or port 6543 pooler) with ?sslmode=require.
DATABASE_URL=postgres://user:password@ep-cool-pooler.us-east-2.aws.neon.tech:6543/neondb?sslmode=require
CONN_MAX_AGE=600
DISABLE_SERVER_SIDE_CURSORS=true

# Fallback individual DB parameters (only used if DATABASE_URL is not set)
POSTGRES_DB=adepteduverse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# 3. Redis Cache & Celery Background Workers
# ==========================================
# NOTE: Redis is required in production for Celery background workers (scoring, transcoding) and caching.
# If REDIS_URL is not configured, /api/health/ returns 200 (if DB is up), but async jobs will not run.
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379/0
CELERY_BROKER_URL=redis://default:your_redis_password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:your_redis_password@your-redis-host:6379/0

# ==========================================
# 4. Cloudflare R2 Object Storage (Recordings & Media)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=adepteduverse-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# ==========================================
# 5. Sentry Monitoring & Error Reporting
# ==========================================
SENTRY_DSN=https://your_public_key@sentry.io/your_project_id
SENTRY_TRACES_SAMPLE_RATE=0.2

# ==========================================
# 6. Next.js Frontend Public Configuration
# ==========================================
# IMPORTANT: NEXT_PUBLIC_API_URL must end with /api (e.g. https://ankit-reso.onrender.com/api)
NEXT_PUBLIC_API_URL=https://ankit-reso.onrender.com/api
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@sentry.io/your_project_id

# ==========================================
# 7. User Seeding & Admin Provisioning (ensure_admin / seed_users)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=your_student_password_here
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_password_here

# ==========================================
# 8. Cloudflare Private Video Streaming & HLS Transcoder
# ==========================================
# Custom domain bound to Cloudflare Worker (e.g. https://video.adepteduverse.com)
VIDEO_STREAMING_DOMAIN=https://video.adepteduverse.com
# Shared HMAC-SHA256 secret between Django API and Cloudflare Worker
VIDEO_STREAMING_SECRET=generate-a-strong-random-64-char-hex-secret
# Enable optional 1080p rendition (off by default to conserve bandwidth/compute)
ENABLE_1080P=false

# ==========================================
# 10. AI Chatbot "Swecha" Configuration
# ==========================================
# Anthropic API Key (Claude) for natural conversational responses.
# If omitted or call fails, Swecha automatically uses the built-in keyword FAQ engine.
ANTHROPIC_API_KEY=
# Anthropic Claude Model (e.g. claude-3-5-sonnet-20241022 or claude-3-haiku-20240307)
CHATBOT_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# 11. Email SMTP (OTP & Notifications)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ANKIT JEE <no-reply@adepteduverse.com>

# ==========================================
# 12. TextBee SMS Gateway (OTP via Android Device)
# ==========================================
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=



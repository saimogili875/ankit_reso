# API Base URL - In production, set to "/api" (if using Next.js proxy rewrites)
# or full URL "https://ankit-reso.onrender.com/api"
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend Origin for Next.js rewrites proxying /api/:path* (used by next.config.ts)
BACKEND_ORIGIN=http://localhost:8000

# Sentry DSN (optional)
NEXT_PUBLIC_SENTRY_DSN=

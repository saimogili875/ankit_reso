# API Base URL - In production, set to "/api" (if using Next.js proxy rewrites)
# or full URL "https://ankit-reso.onrender.com/api"
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend Origin for Next.js rewrites proxying /api/:path* and SSR (used by next.config.ts & lib/config.ts)
# REQUIRED FOR PRODUCTION BUILDS (NODE_ENV=production or VERCEL=1)
# Example: https://ankit-reso.onrender.com
BACKEND_ORIGIN=http://localhost:8000

# Sentry DSN (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Razorpay Standard Checkout (Public Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Clerk Authentication (Student Portal)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

